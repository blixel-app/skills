{
  "name": "blixel",
  "version": "0.3.0",
  "description": "Rooms, meeting chat, window sharing and transcripts through the blixel CLI.",
  "author": {
    "name": "Blixel",
    "url": "https://blixel.app"
  },
  "homepage": "https://blixel.app",
  "repository": "https://github.com/blixel-app/skills",
  "license": "MIT",
  "keywords": [
    "blixel",
    "meetings",
    "transcripts",
    "screen sharing"
  ],
  "experimental": {
    "monitors": [
      {
        "name": "handoffs",
        "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/blixel agent follow",
        "description": "Blixel handoffs",
        "when": "on-skill-invoke:blixel:connect-agent"
      }
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/connect-agent/scripts/session-start.sh\""
          }
        ]
      }
    ]
  }
}
